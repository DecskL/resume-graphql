# Только для локальной разработки: app:app — учётка Postgres из docker-compose.yml. Не использовать на сервере.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgresql://app:app@localhost:5432/resume?schema=public
PORT=3000
# true — логировать SQL-запросы Prisma (удобно проверить, что DataLoader батчит)
PRISMA_LOG_QUERIES=false
