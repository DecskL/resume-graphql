{
  "name": "resume-graphql",
  "version": "1.0.0",
  "description": "Резюме Михаила Никишина в виде GraphQL API (NestJS, Prisma, PostgreSQL)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "prisma migrate deploy && node dist/prisma/seed.js && node dist/src/main.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test -r ts-node/register test/*.test.ts",
    "test:e2e": "node --test --test-concurrency=1 -r ts-node/register test/e2e/*.e2e.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@nestjs/apollo": "^12.2.2",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/graphql": "^12.2.2",
    "@nestjs/platform-express": "^10.4.22",
    "@prisma/client": "^5.22.0",
    "dataloader": "^2.2.3",
    "graphql": "^16.14.2",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.22",
    "@types/node": "^22.20.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "private": true,
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
}
